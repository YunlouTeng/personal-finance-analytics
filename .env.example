# Copy to .env and fill in. Never commit .env.
#
# PLAID_ENV defaults to sandbox on purpose: a missing or mistyped value
# must fail safe, not silently hit production accounts. Set to
# "production" explicitly when running a real sync.
#
# Plaid access tokens are per linked Item and are stored outside this
# file (see ingestion/ once it exists). Do not put them here.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Name of the connection in ~/.snowflake/connections.toml
SNOWFLAKE_CONNECTION_NAME=pfin
